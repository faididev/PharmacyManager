<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/MainBackColor"
    android:fitsSystemWindows="true"
    tools:context=".ui.product.AddProductFragment">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:isScrollContainer="true"
        android:scrollIndicators="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="100dp"
            android:gravity="center">

            <TextView
                android:id="@+id/logo_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Add New Product"
                android:textColor="@color/main_text_color"
                android:textSize="28sp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/slogan_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/roboto"
                android:text="Create a new product"
                android:textColor="@color/secondary_text_color"
                android:textSize="16sp"
                android:textAlignment="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/product_name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Product Name"
                    app:boxStrokeColor="@color/input_focused_border"
                    app:hintTextColor="@color/input_hint"
                    app:boxBackgroundColor="@color/input_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/input_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Image Upload Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Image"
                        android:textColor="@color/main_text_color"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/roboto_bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/product_image_preview"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/ic_image_placeholder"
                            android:scaleType="centerCrop"
                            android:contentDescription="Product Image Preview" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <Button
                                android:id="@+id/btn_select_image"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Select Image"
                                android:textSize="14sp"
                                android:backgroundTint="@color/MainColor"
                                android:textColor="@android:color/white"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/image_status_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No image selected"
                                android:textSize="12sp"
                                android:textColor="@color/secondary_text_color" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/product_description"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Description"
                    app:boxStrokeColor="@color/input_focused_border"
                    app:hintTextColor="@color/input_hint"
                    app:boxBackgroundColor="@color/input_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:inputType="textMultiLine"
                        android:gravity="top"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/input_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Price and Quantity Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/product_price"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Price"
                        app:boxStrokeColor="@color/input_focused_border"
                        app:hintTextColor="@color/input_hint"
                        app:boxBackgroundColor="@color/input_background">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/input_text"
                            android:textColorHint="@color/input_hint" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/product_quantity"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="Quantity"
                        app:boxStrokeColor="@color/input_focused_border"
                        app:hintTextColor="@color/input_hint"
                        app:boxBackgroundColor="@color/input_background">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/input_text"
                            android:textColorHint="@color/input_hint" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/product_total"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Total Stock"
                    app:boxStrokeColor="@color/input_focused_border"
                    app:hintTextColor="@color/input_hint"
                    app:boxBackgroundColor="@color/input_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/input_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Date Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/product_manufacture_date"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Manufacture Date"
                        app:boxStrokeColor="@color/input_focused_border"
                        app:hintTextColor="@color/input_hint"
                        app:boxBackgroundColor="@color/input_background">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/manufacture_date_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="@color/input_text"
                            android:textColorHint="@color/input_hint" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/product_expiry_date"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="Expiry Date"
                        app:boxStrokeColor="@color/input_focused_border"
                        app:hintTextColor="@color/input_hint"
                        app:boxBackgroundColor="@color/input_background">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/expiry_date_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="@color/input_text"
                            android:textColorHint="@color/input_hint" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Category Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/product_category"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Category"
                    app:boxStrokeColor="@color/input_focused_border"
                    app:hintTextColor="@color/input_hint"
                    app:boxBackgroundColor="@color/input_background">

                    <AutoCompleteTextView
                        android:id="@+id/category_dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/input_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/create_product_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/MainColor"
                    android:fontFamily="@font/roboto"
                    android:text="Create Product"
                    android:textAllCaps="false"
                    android:textColor="@color/MainBackColor"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@color/transpirant"
                    android:elevation="0dp"
                    android:fontFamily="@font/roboto"
                    android:text="Back to List"
                    android:textAllCaps="false"
                    android:textColor="@color/main_text_color"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
