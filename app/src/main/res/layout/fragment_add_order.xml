<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/MainBackColor"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/roboto_bold"
            android:text="Create New Order"
            android:textColor="@color/main_text_color"
            android:textSize="24sp"
            android:textAlignment="center" />

        <!-- Customer Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Select Customer"
            android:textColor="@color/main_text_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/customer_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/spinner_background"
                android:padding="12dp" />

            <Button
                android:id="@+id/btn_refresh_customers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/quantity_button_background"
                android:text="↻"
                android:textColor="@color/MainColor"
                android:textSize="16sp"
                android:textStyle="bold"
                android:minWidth="40dp"
                android:minHeight="40dp" />

        </LinearLayout>

        <!-- Order Status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Order Status"
            android:textColor="@color/main_text_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_bold" />

        <Spinner
            android:id="@+id/status_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/spinner_background"
            android:padding="12dp" />

        <!-- Product Selection Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Select Products"
            android:textColor="@color/main_text_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_bold" />

        <!-- Product Search -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Search products..."
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/input_focused_border"
            app:hintTextColor="@color/input_hint"
            app:boxBackgroundColor="@color/input_background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Products List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_products"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            android:background="@color/input_background"
            android:padding="8dp" />

        <!-- Order Items Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Selected Items"
            android:textColor="@color/main_text_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_bold" />

        <LinearLayout
            android:id="@+id/order_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <!-- Order items will be added dynamically here -->

        </LinearLayout>

        <!-- Total Amount Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/total_amount_background"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Amount:"
                android:textColor="@color/main_text_color"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_bold" />

            <TextView
                android:id="@+id/total_amount_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="@color/MainColor"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_bold" />

        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/create_order_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/MainColor"
            android:fontFamily="@font/roboto"
            android:text="Create Order"
            android:textAllCaps="false"
            android:textColor="@color/MainBackColor"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transpirant"
            android:elevation="0dp"
            android:fontFamily="@font/roboto"
            android:text="Back to Orders"
            android:textAllCaps="false"
            android:textColor="@color/main_text_color"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
